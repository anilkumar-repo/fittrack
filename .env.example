# Copy to .env.local for local development. Never commit real values.
# Full explanation of every key: docs/SETUP_AND_HISTORY.md (section 2).

# Supabase (public, browser-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Push notifications (Phase 12). Only needed to test notifications locally.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# SECRET values below: server only, never NEXT_PUBLIC_
VAPID_PRIVATE_KEY=
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# Optional, defaults to https://rozfit-a.vercel.app
VAPID_SUBJECT=

# Rozi AI. Keys are SECRET: server only — never NEXT_PUBLIC_ (the app refuses to run Rozi AI if one is).
# Without a key for the chosen provider, Rozi keeps answering on the device.
# Check: npm run rozi:ping  ·  compare models: npm run rozi:bench  (docs/ROZI_AI_INTEGRATION.md)
# Several models, tried in order when one is busy / rate-limited / slow (recommended; overrides the two lines below):
# ROZI_AI_CHAIN=groq:openai/gpt-oss-20b,groq:openai/gpt-oss-120b,gemini:gemini-3.5-flash-lite
ROZI_AI_CHAIN=
# Or ONE provider and ONE model (don't repeat these two lines).
ROZI_AI_PROVIDER=gemini
# gemini: gemini-3.8-flash (default) · groq: openai/gpt-oss-120b (default), openai/gpt-oss-20b, qwen/qwen3.8-27b
ROZI_AI_MODEL=
GEMINI_API_KEY=
GROQ_API_KEY=
